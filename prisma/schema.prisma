// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PickupRequest {
  id                              String        @id @default(cuid())
  stage                           String
  sourcingDealNo                  String
  pickup                          String?
  location                        String?
  actualPickupDate                DateTime?
  actualDeliveredDate             DateTime?
  files                           PickupFile[]
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  @@unique([sourcingDealNo])
  @@index([sourcingDealNo])
  @@index([stage])
}

model PickupFile {
  id              String         @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest  @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  fileName        String
  fileSize        Int
  mimeType        String
  storagePath     String
  createdAt       DateTime       @default(now())

  @@index([pickupRequestId])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String?
  role        Role     @default(VIEWER)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
