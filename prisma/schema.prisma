// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PickupRequest {
  id                              String        @id @default(cuid())
  stage                           String
  sourcingDealNo                  String
  pickup                          String?
  location                        String?
  actualPickupDate                DateTime?
  actualDeliveredDate             DateTime?
  accessPoint                     Int?
  desktop                         Int?
  ipTelephonyEpbxDevices          Int?
  laptop                          Int?
  mixEWaste                       Int?
  mixPeripherals                  Int?
  mobile                          Int?
  router                          Int?
  server                          Int?
  switch                          Int?
  tablet                          Int?
  tftMonitor                      Int?
  files                           PickupFile[]
  quotes                          Quote[]
  dataWipings                     DataWiping[]
  certificates                    Certificate[]
  grns                            Grn[]
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  @@unique([sourcingDealNo])
  @@index([sourcingDealNo])
  @@index([stage])
}

model Quote {
  id              String            @id @default(cuid())
  stage           String
  sourcingDealNo  String
  pickup          String?
  quoteNo         String?
  totalAmount     Float?
  locationCode    String?
  pickupRequestId String?
  pickupRequest   PickupRequest?    @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]
  files           QuoteFile[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([quoteNo])
  @@index([stage])
}

model PurchaseOrder {
  id              String            @id @default(cuid())
  stage           String
  sourcingDealNo  String
  pickup          String?
  quoteNo         String?
  purchaseOrderNo String?
  locationCode    String?
  quoteId         String?
  quote           Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  payments        Payment[]
  files           PurchaseOrderFile[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([quoteNo])
  @@index([purchaseOrderNo])
  @@index([stage])
}

model Payment {
  id                 String            @id @default(cuid())
  stage              String
  sourcingDealNo     String
  pickup             String?
  purchaseOrderNo    String?
  payment            String?
  totalInvoiceAmount Float?
  totalPaymentDone   Float?
  balanceAmount      Float?
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  files              PaymentFile[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([purchaseOrderNo])
  @@index([stage])
}

model PickupFile {
  id              String         @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest  @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  fileName        String
  fileSize        Int
  mimeType        String
  storagePath     String
  category        String?
  createdAt       DateTime       @default(now())

  @@index([pickupRequestId])
}

model QuoteFile {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  category    String?
  createdAt   DateTime @default(now())

  @@index([quoteId])
}

model PurchaseOrderFile {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileName        String
  fileSize        Int
  mimeType        String
  storagePath     String
  category        String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
}

model PaymentFile {
  id          String  @id @default(cuid())
  paymentId   String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  category    String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model DataWiping {
  id                String            @id @default(cuid())
  status            String
  sourcingDealNo    String
  pickup            String?
  dataWipingId      String?
  laptop            Int?
  desktop           Int?
  total             Int?
  laptopSsdHddReceived Int?
  laptopWiped       Int?
  laptopShreddingDone Int?
  laptopNotWiped    Int?
  desktopSsdHddReceived Int?
  desktopWiped      Int?
  desktopShreddingDone Int?
  desktopNotWiped   Int?
  pickupRequestId   String?
  pickupRequest     PickupRequest?    @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  files             DataWipingFile[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([status])
}

model DataWipingFile {
  id            String       @id @default(cuid())
  dataWipingId  String
  dataWiping    DataWiping   @relation(fields: [dataWipingId], references: [id], onDelete: Cascade)
  fileName      String
  fileSize      Int
  mimeType      String
  storagePath   String
  category      String?
  createdAt     DateTime     @default(now())

  @@index([dataWipingId])
}

model DataWipingMaster {
  id                String     @id @default(cuid())
  pickupId          String?
  serialNumber      String?
  assetType         String?
  hddSerialNumber   String?
  wiped             String?
  wipedSoftware     String?
  wipedDate         String?
  hddAvailable      String?
  size              String?
  remarks           String?
  pdfName           String?
  storagePath       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([pickupId])
  @@index([serialNumber])
  @@index([assetType])
  @@index([hddSerialNumber])
}

model Certificate {
  id              String            @id @default(cuid())
  status          String
  sourcingDealNo  String
  pickup          String?
  pickupRequestId String?
  pickupRequest   PickupRequest?    @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  files           CertificateFile[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([status])
}

model CertificateFile {
  id             String       @id @default(cuid())
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  mimeType       String
  storagePath    String
  category       String?
  createdAt      DateTime     @default(now())

  @@index([certificateId])
}

model Grn {
  id                    String            @id @default(cuid())
  stage                 String
  sourcingDealNo        String
  pickup                String?
  grnDetails            String?
  invoiceNumber         String?
  invoiceDate           String?
  materialReceivedDate  String?
  pickupRequestId       String?
  pickupRequest         PickupRequest?    @relation(fields: [pickupRequestId], references: [id], onDelete: SetNull)
  files                 GrnFile[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([sourcingDealNo])
  @@index([stage])
}

model GrnFile {
  id          String  @id @default(cuid())
  grnId       String
  grn         Grn     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  category    String?
  createdAt   DateTime @default(now())

  @@index([grnId])
}

model Consolidated {
  id          String   @id @default(cuid())
  category    String
  subCategory String?
  qty         Int?
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String?
  role        Role     @default(VIEWER)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
